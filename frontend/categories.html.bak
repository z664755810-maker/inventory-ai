<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>京东电子商品物流系统 - 商品类型</title>
    <link rel="stylesheet" href="css/style.css">
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
</head>
<body>
    <div id="app" class="main-container">
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-icon">📦</div>
                    <h1>京东电子商品物流系统</h1>
                </div>
            </div>
            <div class="sidebar-menu">
                <ul>
                    <li><a href="index.html"><i>🏠</i> 系统首页</a></li>
                    <li><a href="users.html"><i>👥</i> 用户管理</a></li>
                    <li><a href="categories.html" class="active"><i>📁</i> 商品类型</a></li>
                    <li><a href="products.html"><i>📦</i> 商品档案</a></li>
                    <li><a href="customers.html"><i>👤</i> 客户档案</a></li>
                    <li><a href="purchase-orders.html"><i>📥</i> 采购入库</a></li>
                    <li><a href="sales-orders.html"><i>📤</i> 销售出库</a></li>
                    <li><a href="stock.html"><i>📊</i> 库存查询</a></li>
                    <li><a href="invoices.html"><i>🧾</i> 发票管理</a></li>
                </ul>
            </div>
        </div>
        <div class="content">
            <div class="header">
                <h2>📁 商品类型管理</h2>
                <div class="user-info">
                    <span>欢迎, <strong>{{ currentUser?.username || 'Admin' }}</strong></span>
                    <div class="user-avatar">{{ (currentUser?.username || 'A').charAt(0).toUpperCase() }}</div>
                    <button class="logout-btn" @click="handleLogout"><i>🚪</i> 退出登录</button>
                </div>
            </div>
            <div class="page-content">
                <div class="card">
                    <div class="card-header">
                        <h3>商品类型</h3>
                        <button class="btn btn-primary" @click="showAddModal()">添加类型</button>
                    </div>
                    <div id="treeContainer" style="padding-left: 10px;">
                        <span v-if="loading">加载中...</span>
                        <div v-else>
                            <tree-node
                                v-for="item in categoryTree"
                                :key="item.id"
                                :item="item"
                                :level="0"
                                @add="showAddModal"
                                @edit="showEditModal"
                                @delete="deleteCategory"
                            ></tree-node>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div v-if="modalVisible" class="modal-overlay" @click.self="closeModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>{{ modalTitle }}</h3>
                <button class="modal-close" @click="closeModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>类型名称</label>
                    <input type="text" v-model="formData.name" placeholder="请输入类型名称">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @click="closeModal">取消</button>
                <button class="btn btn-primary" @click="handleModalSubmit">{{ modalSubmitText }}</button>
            </div>
        </div>
    </div>

    <div v-if="alertVisible" :class="['alert', `alert-${alertType}`]">
        {{ alertMessage }}
    </div>
    
    <script src="js/api.js"></script>
    <script>
        const { createApp, ref, onMounted, reactive } = Vue;

        const TreeNode = {
            name: 'TreeNode',
            props: {
                item: {
                    type: Object,
                    required: true
                },
                level: {
                    type: Number,
                    default: 0
                }
            },
            emits: ['add', 'edit', 'delete'],
            setup(props, { emit }) {
                const expanded = ref(true);
                
                const toggleExpand = () => {
                    if (props.item.children && props.item.children.length > 0) {
                        expanded.value = !expanded.value;
                    }
                };
                
                const getExpandIcon = () => {
                    if (!props.item.children || props.item.children.length === 0) {
                        return '◉';
                    }
                    return expanded.value ? '▼' : '▶';
                };
                
                return {
                    expanded,
                    toggleExpand,
                    getExpandIcon
                };
            },
            template: `
                <div class="tree-item" :id="'tree-item-' + item.id">
                    <div 
                        class="tree-label" 
                        :style="{ paddingLeft: level * 15 + 'px' }"
                        @click="toggleExpand"
                    >
                        <span class="expand-icon">{{ getExpandIcon() }}</span>
                        <span>{{ item.name }}</span>
                    </div>
                    <div class="tree-actions">
                        <button class="btn-edit" @click="() => $emit('edit', item.id)">编辑</button>
                        <button class="btn-delete" @click="() => $emit('delete', item.id)">删除</button>
                    </div>
                    <div 
                        v-if="item.children && item.children.length > 0"
                        :id="'children-' + item.id"
                        class="children"
                        :style="{ display: expanded ? 'block' : 'none' }"
                    >
                        <tree-node
                            v-for="child in item.children"
                            :key="child.id"
                            :item="child"
                            :level="level + 1"
                            @add="$emit('add', $event)"
                            @edit="$emit('edit', $event)"
                            @delete="$emit('delete', $event)"
                        ></tree-node>
                    </div>
                </div>
            `
        };

        const app = createApp({
            components: {
                TreeNode
            },
            setup() {
                const currentUser = ref(null);
                const categoryTree = ref([]);
                const loading = ref(true);
                
                const modalVisible = ref(false);
                const modalTitle = ref('');
                const modalSubmitText = ref('');
                const editingId = ref(null);
                const parentId = ref(null);
                
                const formData = reactive({
                    name: ''
                });
                
                const alertVisible = ref(false);
                const alertMessage = ref('');
                const alertType = ref('success');
                
                const showAlert = (message, type = 'success') => {
                    alertMessage.value = message;
                    alertType.value = type;
                    alertVisible.value = true;
                    setTimeout(() => {
                        alertVisible.value = false;
                    }, 3000);
                };
                
                const handleLogout = async () => {
                    if (confirm('确定要退出登录吗？')) {
                        try {
                            await api.logout();
                            window.location.href = 'login.html';
                        } catch (error) {
                            window.location.href = 'login.html';
                        }
                    }
                };
                
                const loadCurrentUser = async () => {
                    try {
                        currentUser.value = await api.getCurrentUser();
                    } catch (error) {
                        window.location.href = 'login.html';
                    }
                };
                
                const loadCategories = async () => {
                    loading.value = true;
                    try {
                        categoryTree.value = await api.getCategoryTree();
                    } catch (error) {
                        showAlert(error.message, 'error');
                    } finally {
                        loading.value = false;
                    }
                };
                
                const showAddModal = (parentIdValue = null) => {
                    parentId.value = parentIdValue;
                    editingId.value = null;
                    modalTitle.value = '添加商品类型';
                    modalSubmitText.value = '添加';
                    formData.name = '';
                    modalVisible.value = true;
                };
                
                const showEditModal = async (id) => {
                    try {
                        const category = await api.getCategory(id);
                        editingId.value = id;
                        parentId.value = null;
                        modalTitle.value = '编辑商品类型';
                        modalSubmitText.value = '保存';
                        formData.name = category.name;
                        modalVisible.value = true;
                    } catch (error) {
                        showAlert(error.message, 'error');
                    }
                };
                
                const closeModal = () => {
                    modalVisible.value = false;
                    formData.name = '';
                    editingId.value = null;
                    parentId.value = null;
                };
                
                const handleModalSubmit = async () => {
                    const name = formData.name.trim();
                    if (!name) {
                        showAlert('请输入类型名称', 'error');
                        return;
                    }
                    
                    try {
                        if (editingId.value) {
                            await api.updateCategory(editingId.value, { name });
                            showAlert('商品类型更新成功');
                        } else {
                            await api.createCategory({ name, parent_id: parentId.value });
                            showAlert('商品类型添加成功');
                        }
                        closeModal();
                        loadCategories();
                    } catch (error) {
                        showAlert(error.message, 'error');
                    }
                };
                
                const deleteCategory = async (id) => {
                    if (!confirm('确定要删除该商品类型吗？该类型下的子类型也将被删除。')) return;
                    
                    try {
                        await api.deleteCategory(id);
                        showAlert('商品类型删除成功');
                        loadCategories();
                    } catch (error) {
                        showAlert(error.message, 'error');
                    }
                };
                
                onMounted(async () => {
                    await loadCurrentUser();
                    await loadCategories();
                });
                
                return {
                    currentUser,
                    categoryTree,
                    loading,
                    modalVisible,
                    modalTitle,
                    modalSubmitText,
                    formData,
                    alertVisible,
                    alertMessage,
                    alertType,
                    handleLogout,
                    showAddModal,
                    showEditModal,
                    closeModal,
                    handleModalSubmit,
                    deleteCategory
                };
            }
        });

        app.mount('#app');
    </script>
</body>
</html>